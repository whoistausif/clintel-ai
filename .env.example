CLINTEL_ENV=development
CLINTEL_API_KEY=replace-with-a-long-random-secret
CLINTEL_DATABASE_URL=postgresql://clintel_app:change-this-app-password@localhost:5432/clintel
CLINTEL_INGEST_DATABASE_URL=postgresql://clintel_ingest:change-this-ingest-password@localhost:5432/clintel
CLINTEL_MODEL_PATH=artifacts/readmission-demo.joblib
CLINTEL_AUDIT_PATH=artifacts/audit.jsonl
CLINTEL_DATA_MODE=synthetic
CLINTEL_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
POSTGRES_PASSWORD=change-this-admin-password
CLINTEL_APP_PASSWORD=change-this-app-password
CLINTEL_INGEST_PASSWORD=change-this-ingest-password
